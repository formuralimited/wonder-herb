# Local MongoDB used by the admin. Copy to .env to override.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=wonderherb
PORT=4000

# One account that no other administrator can demote, disable, delete or
# reset. Created at startup if missing; the password is only used then.
SUPER_ADMIN_EMAIL=owner@wonder-herb.com
SUPER_ADMIN_PASSWORD=change-this-before-first-run
SUPER_ADMIN_NAME=Site Owner

# The public chat widget's answer service (server/chat.js, POST /api/chat).
# With OPENAI_API_KEY unset the service returns "unavailable" and the widget
# renders the honest state it already ships with - so leaving this blank is a
# supported configuration, not a broken one.
#
# NEVER commit a real key. This file is the template; .env is gitignored.
# Use a key scoped to this project with a spend limit set in the OpenAI
# dashboard: the endpoint is public, so the limit is the backstop behind the
# per-IP and daily caps in server/chat.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hard ceiling on model calls per calendar day, across all visitors. The
# per-IP windows live in server/chat.js (8/minute, 40/hour).
CHAT_DAILY_MAX=1000

# ---------------------------------------------------------------- Phase 10
# The media bucket (Alibaba Cloud OSS), used ONLY by `npm run media:upload`.
# Nothing the public site serves reads these: the bucket's public URL lives in
# data/site.json as media.base, because a heavy or externally hosted asset is
# a tree field, never markup. These four are upload credentials, nothing more.
#
# NEVER commit real values. This file is the template; .env is gitignored.
#
# OSS_BUCKET   the bucket name you chose in the OSS console.
# OSS_REGION   the region id, bare: cn-hongkong, NOT oss-cn-hongkong. The
#              script strips an oss- prefix if you paste one, because the
#              SigV4 credential scope wants the bare form and OSS rejects the
#              request with a signature error rather than a useful one.
# OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET
#              a RAM user's AccessKey pair, not the root account's. Give that
#              user one policy scoped to this bucket (AliyunOSSFullAccess is
#              wider than this job needs). The secret is shown ONCE at
#              creation; if it is lost, delete the key and make another.
# OSS_PREFIX   optional, defaults to media/. The key prefix every object goes
#              under, so the bucket can hold something else later without the
#              manifest's keys becoming ambiguous.
# OSS_ENDPOINT optional. Overrides the derived
#              https://<bucket>.oss-<region>.aliyuncs.com, for an internal
#              endpoint or a custom domain. Phase 18, not now.
OSS_BUCKET=
OSS_REGION=cn-hongkong
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=media/
