          "zh": "產品功效及特性",
          "en": "Key Benefits & Features"
        },
        "bullets": [
          {
            "label": {
              "zh": "抑制HBV病毒：",
              "en": "Inhibits the HBV virus:"
            },
            "text": {
              "zh": "有助抑制乙型肝炎病毒複製，降低病毒活性",
              "en": "Helps inhibit replication of the hepatitis B virus and lower viral activity"
            }
          },
          {
            "label": {
              "zh": "抗肝纖維化：",
              "en": "Anti-fibrotic:"
            },
            "text": {
              "zh": "減輕肝細胞炎症，防止肝纖維化進展",
              "en": "Eases liver-cell inflammation and prevents the progression of liver fibrosis"
            }
          },
          {
            "label": {
              "zh": "預防肝硬化：",
              "en": "Prevents cirrhosis:"
            },
            "text": {
              "zh": "有助減低和防止肝硬化及其併發症（腹水、靜脈曲張等）的風險",
              "en": "Helps reduce and prevent the risk of cirrhosis and its complications (ascites, varices and so on)"
            }
          },
          {
            "label": {
              "zh": "延緩疾病發展：",
              "en": "Slows disease progression:"
            },
            "text": {
              "zh": "有助延緩慢性肝病的進程，保護剩餘肝功能",
              "en": "Helps slow the progression of chronic liver disease and protect remaining liver function"
            }
          },
          {
            "label": {
              "zh": "零西藥副作用：",
              "en": "No Western-drug side effects:"
            },
            "text": {
              "zh": "全天然草本，無抗病毒藥物的常見不良反應（如腎損傷、胃腸不適）",
              "en": "Wholly natural herbs, without the common adverse reactions of antiviral drugs (such as kidney damage or gastrointestinal upset)"
            }
          }
        ],
        "variant": "group",
        "spacedHeading": true
      }
