          "zh": "產品功效及特性",
          "en": "Key Benefits & Features"
        },
        "bullets": [
          {
            "label": {
              "zh": "修復腦細胞：",
              "en": "Repairs brain cells:"
            },
            "text": {
              "zh": "幫助修復受損的神經細胞，延緩腦部老化",
              "en": "Helps repair damaged nerve cells and slow the ageing of the brain"
            }
          },
          {
            "label": {
              "zh": "增強記憶力：",
              "en": "Strengthens memory:"
            },
            "text": {
              "zh": "改善短期及長期記憶，提升學習能力",
              "en": "Improves short- and long-term memory and learning ability"
            }
          },
          {
            "label": {
              "zh": "提升專注力：",
              "en": "Improves concentration:"
            },
            "text": {
              "zh": "增加集中力，減少分心，提高工作效率",
              "en": "Increases focus, reduces distraction and improves productivity"
            }
          },
          {
            "label": {
              "zh": "天然腦細胞重生化合物：",
              "en": "Natural brain-cell regeneration compound:"
            },
            "text": {
              "zh": "源自天然蛋白腖，安全無依賴性",
              "en": "Derived from natural Peptone; safe and non-habit-forming"
            }
          },
          {
            "label": {
              "zh": "科學實證：",
              "en": "Scientifically evidenced:"
            },
            "text": {
              "zh": "功效獲得科學研究和臨床數據支持",
              "en": "Its effects are supported by scientific research and clinical data"
            }
          }
        ],
        "variant": "group",
        "spacedHeading": true
      }
    },
    {
